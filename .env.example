# 🛡️ PhishShield AI Environment Configuration

PROJECT_NAME="PhishShield AI — Enterprise Multimodal Phishing Detector"
VERSION="2.0.0"
DEBUG=False
API_V1_STR="/api/v1"

# Scoring Engine Weights
WEIGHT_VISION=0.30
WEIGHT_DOM_CODE=0.25
WEIGHT_URL_WHOIS=0.25
WEIGHT_NLP_PRETEXT=0.12
WEIGHT_METADATA_SSL=0.08

# Thresholds
CRITICAL_RISK_THRESHOLD=70.0
HIGH_RISK_THRESHOLD=55.0
SUSPICIOUS_RISK_THRESHOLD=35.0
VISUAL_CLONE_THRESHOLD=0.72

# Crawler & Network
CRAWLER_TIMEOUT_SECONDS=8
CRAWLER_HEADLESS=True

# Database (Default: SQLite, for Postgres use: postgresql://user:pass@host:5432/phishshield)
# SQLALCHEMY_DATABASE_URI="sqlite:///backend/app/data/phishshield.db"
