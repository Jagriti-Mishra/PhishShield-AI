{
  "manifest_version": 3,
  "name": "PhishShield AI - SIH 1454 Phishing Detector",
  "version": "1.0.0",
  "description": "Real-time AI Phishing & Visual Domain Impersonation Protection for SIH 1454",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>",
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "PhishShield AI"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
